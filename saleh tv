    <!-- استدعاء خط تاريخي فخم (Cinzel) للعنوان -->
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@700&display=swap" rel="stylesheet">
    <style>
        :root { 
            --accent-gold: #d4af37; 
            --bg: #0a0a0a; 
        }
        body { 
            background-color: var(--bg); 
            background-image: url('https://i.ibb.co/5gg3JfVt/020f249289e7b1a14246867c2756d297.webp');
            background-size: cover;
            background-attachment: fixed;
            background-position: center;
            color: white; 
            font-family: sans-serif; 
            margin: 0; 
            padding: 0;
        }
        header {
            text-align: center;
            padding: 0px; 
            height: 70px; 
            background: url('https://i.ibb.co/Xr6kkKvX/Screenshot.webp') no-repeat center center;
            background-size: 100% 100%; 
            border-bottom: 2px solid var(--accent-gold);
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
        }
        /* تصميم خط جوهري تاريخي لعنوان الشريط */
        header h1 {
            display: block; 
            font-family: 'Cinzel', serif;
            font-size: 26px;
            color: #ffdf73;
            letter-spacing: 2px;
            margin: 0;
            text-shadow: 2px 2px 0px #332400, 4px 4px 5px rgba(0,0,0,0.8), 0 0 15px #d4af37, 0 0 20px #d4af37;
            z-index: 2;
        }
        
        .page { display: none; padding: 20px; }
        .active { display: block; }
        
        .top-actions-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 15px; 
            margin-bottom: 25px; 
            padding: 0 5px;
        }
        
        .telegram-btn {
            width: 45px;
            height: 45px;
            display: block;
            border-radius: 50%;
            box-shadow: 0 4px 10px rgba(0,0,0,0.6);
            transition: transform 0.2s;
        }
        .telegram-btn img {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            object-fit: cover;
        }
        
        .player-btn {
            display: flex;
            align-items: center;
            background: rgba(0, 0, 0, 0.85);
            border: 1px solid var(--accent-gold);
            padding: 6px 12px;
            border-radius: 25px;
            text-decoration: none;
            color: white;
            box-shadow: 0 4px 10px rgba(0,0,0,0.6);
        }
        .player-btn img {
            width: 25px;
            height: 25px;
            margin-left: 8px;
            border-radius: 5px;
        }
        .player-btn span {
            font-size: 0.85em;
            font-weight: bold;
            color: var(--accent-gold);
        }

        .section-card { 
            position: relative;
            height: 160px; margin-bottom: 20px; border-radius: 15px; 
            cursor: pointer; border: 2px solid var(--accent-gold); 
            overflow: hidden; background-position: center;
            background-repeat: no-repeat; background-size: 100% 100%;
            display: flex; align-items: center; justify-content: center; 
        }
        .section-card::before, .card::before {
            content: ""; position: absolute; top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(0, 0, 0, 0.4); z-index: 1;
        }
        .section-text { position: relative; z-index: 2; text-align: center; }
        .main-title-en { font-size: 1.6em; color: var(--accent-gold); font-weight: bold; text-shadow: 2px 2px 8px #000; display: block; }
        .main-title-ar { font-size: 1.1em; color: #fff; margin-top: 5px; font-weight: bold; text-shadow: 2px 2px 8px #000; display: block; }

        .card { 
            position: relative; height: 120px; margin-bottom: 15px; border-radius: 12px; 
            cursor: pointer; border: 1px solid var(--accent-gold); overflow: hidden;
            background-size: 100% 100%; background-position: center; display: flex; align-items: flex-end; 
            text-decoration: none;
        }
        .card::before {
            content: ""; position: absolute; top: 0; left: 0; right: 0; bottom: 0;
            background: linear-gradient(to top, rgba(0,0,0,0.9) 0%, rgba(0,0,0,0.2) 100%); z-index: 1;
        }
        .card-text { position: relative; z-index: 2; padding: 15px; width: 100%; }
        .name-en { font-size: 1.25em; color: var(--accent-gold); font-weight: bold; text-shadow: 2px 2px 6px #000; display: block; }
        .name-ar { font-size: 1.1em; color: #fff; margin-top: 3px; font-weight: bold; text-shadow: 2px 2px 6px #000; display: block; }

        .tv-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 12px;
            margin-top: 15px;
        }
        .tv-grid-card {
            background: rgba(18, 24, 36, 0.9);
            border: 2px solid var(--accent-gold);
            border-radius: 15px;
            padding: 8px;
            text-align: center;
            text-decoration: none;
            display: block;
            box-shadow: 0 4px 10px rgba(0,0,0,0.7);
        }
        .tv-grid-img {
            width: 100%;
            aspect-ratio: 1 / 1;
            border-radius: 10px;
            background-size: 100% 100%;
            background-position: center;
            border: 1px solid var(--accent-gold);
            margin-bottom: 6px;
        }
        .tv-grid-text {
            color: white;
            font-size: 0.9em;
            font-weight: bold;
            text-shadow: 1px 1px 3px #000;
        }
        .tv-grid-text span {
            color: var(--accent-gold);
            display: block;
            font-size: 0.85em;
        }

        .series-card {
            background: transparent !important;
            border: none !important;
            box-shadow: none !important;
            padding: 0 !important;
            transform: scale(0.90);
        }
        .series-card .tv-grid-img {
            background-size: 100% 100% !important;
            aspect-ratio: 3 / 4;
            border-radius: 12px;
            border: 2px solid var(--accent-gold);
            margin-bottom: 8px;
        }
        .series-card .tv-grid-text {
            color: white !important;
            font-size: 1em !important;
            text-shadow: 3px 3px 5px #000, -2px -2px 5px #000, 0px 0px 10px #000, 0px 0px 15px #000 !important; 
        }

        .custom-tv-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 12px;
            margin-top: 15px;
        }
        .custom-tv-card {
            position: relative;
            height: 120px;
            border-radius: 12px;
            cursor: pointer;
            border: 1px solid var(--accent-gold);
            overflow: hidden;
            background-size: 100% 100%;
            background-position: center;
            display: flex;
            align-items: flex-end;
            text-decoration: none;
            box-shadow: 0 4px 10px rgba(0,0,0,0.7);
        }
        .custom-tv-card::before {
            content: "";
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background: linear-gradient(to top, rgba(0,0,0,0.95) 0%, rgba(0,0,0,0.2) 100%);
            z-index: 1;
        }
        .custom-tv-text {
            position: relative;
            z-index: 2;
            padding: 8px;
            width: 100%;
            text-align: right;
        }
        .custom-tv-en {
            font-size: 0.85em;
            color: var(--accent-gold);
            font-weight: bold;
            text-shadow: 2px 2px 4px #000;
            display: block;
        }
        .custom-tv-ar {
            font-size: 0.7em;
            color: #fff;
            margin-top: 2px;
            font-weight: bold;
            text-shadow: 2px 2px 4px #000;
            display: block;
        }

        .back-btn { color: var(--accent-gold); margin-bottom: 20px; cursor: pointer; font-size: 1.2em; display: inline-block; font-weight: bold; background: rgba(0,0,0,0.6); padding: 5px 12px; border-radius: 8px; border: 1px solid var(--accent-gold); }

        .search-container {
            text-align: center;
            margin-bottom: 35px; 
        }
        .search-bar {
            width: 90%;
            padding: 12px 20px;
            border-radius: 30px;
            border: 1px solid var(--accent-gold);
            background: rgba(0, 0, 0, 0.75);
            color: white;
            font-size: 1.1em;
            outline: none;
            box-shadow: 0 4px 8px rgba(0,0,0,0.5);
            font-family: inherit;
        }
        .search-bar::placeholder {
            color: #ccc;
            font-weight: bold;
        }
