<script>
    // نظام التنقل بين الأقسام
    function navigateTo(pageId) {
        document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
        document.getElementById(pageId).classList.add('active');
        
        // تفريغ حقول البحث عند التنقل وإعادة العناصر للظهور
        document.querySelectorAll('.search-bar').forEach(bar => {
            bar.value = '';
            const event = new Event('input');
            bar.dispatchEvent(event);
        });
        
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // نظام البحث الدقيق بمجرد كتابة حرف
    window.addEventListener('load', () => {
        const searchInputs = document.querySelectorAll('.search-bar');
        searchInputs.forEach(input => {
            input.addEventListener('input', function() {
                const filter = this.value.toLowerCase().trim();
                const activePage = this.closest('.page');
                
                if (!activePage) return;
                
                // البحث داخل جميع أنواع الكروت في الصفحة المفتوحة
                const items = activePage.querySelectorAll('.section-card, .card, .tv-grid-card, .custom-tv-card');
                
                items.forEach(item => {
                    const text = item.textContent || item.innerText;
                    if (text.toLowerCase().indexOf(filter) > -1) {
                        item.style.display = "";
                    } else {
                        item.style.display = "none";
                    }
                });
            });
        });
    });
</script>
